rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra padrão: Apenas usuários autenticados têm acesso a suas próprias coleções
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Coleção pública somente leitura de exemplo
    match /public_data/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Coleções gerais: leitura e escrita apenas para usuários autenticados
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
