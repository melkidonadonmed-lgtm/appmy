# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR BACKEND (Cloud Run / Node.js)
# ==============================================================================
NODE_ENV=development
PORT=8080

# ==============================================================================
# GOOGLE CLOUD PLATFORM & FIREBASE ADMIN SDK
# ==============================================================================
# No Cloud Run, o ADC (Application Default Credentials) é resolvido automaticamente.
# Para execução local com privilégios de Admin, aponte para sua chave de serviço:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
GCP_PROJECT_ID=agent-md-506215

# ==============================================================================
# FIREBASE CLIENT (Vite Frontend - Variáveis prefixadas com VITE_)
# ==============================================================================
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyExampleOnly1234567890
VITE_FIREBASE_AUTH_DOMAIN=agent-md-506215.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agent-md-506215
VITE_FIREBASE_STORAGE_BUCKET=agent-md-506215.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
